<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Standpoint Brief</title>
<meta name="description" content="A daily markets, macro, and commercial real estate brief.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📈</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;0,700;1,500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root {
    color-scheme: light;
    --plane:#e9edf1; --surface:#fbfcfd; --surface-2:#f2f5f8;
    --ink:#0f1b26; --ink-2:#45535f; --muted:#7d8a97;
    --accent:#0e4f6e; --accent-soft:#d7e6ee; --brass:#a9741f;
    --hair:#d5dce2; --hair-strong:#bcc6ce; --up:#0a7d34; --down:#bb392f; --grid:#e3e8ed;
    --s1:#0e4f6e; --s1-soft:#7fb2c9;
    --shadow:0 1px 2px rgba(15,27,38,.05),0 8px 24px -14px rgba(15,27,38,.22);
    --maxw:1180px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      color-scheme:dark;
      --plane:#0a0f14; --surface:#131c24; --surface-2:#182430;
      --ink:#eef3f7; --ink-2:#a6b6c3; --muted:#7f8f9c;
      --accent:#46a8cd; --accent-soft:#17323f; --brass:#d0a24e;
      --hair:#263440; --hair-strong:#354857; --up:#34b357; --down:#e5695f; --grid:#21303b;
      --s1:#46a8cd; --s1-soft:#2b5a6f;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 12px 30px -16px rgba(0,0,0,.7);
    }
  }
  :root[data-theme="dark"]{
    color-scheme:dark;
    --plane:#0a0f14; --surface:#131c24; --surface-2:#182430;
    --ink:#eef3f7; --ink-2:#a6b6c3; --muted:#7f8f9c;
    --accent:#46a8cd; --accent-soft:#17323f; --brass:#d0a24e;
    --hair:#263440; --hair-strong:#354857; --up:#34b357; --down:#e5695f; --grid:#21303b;
    --s1:#46a8cd; --s1-soft:#2b5a6f;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 12px 30px -16px rgba(0,0,0,.7);
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--plane);color:var(--ink);
    font-family:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  .mono{font-family:"IBM Plex Mono",ui-monospace,"SF Mono",Menlo,monospace;font-variant-numeric:tabular-nums;}
  .serif{font-family:"Spectral",Georgia,"Times New Roman",serif;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  a{color:var(--accent);text-decoration:none;}
  a:hover{text-decoration:underline;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px;}

  .masthead{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--plane) 88%,transparent);
    backdrop-filter:saturate(1.3) blur(10px);border-bottom:1px solid var(--hair);}
  .mast-top{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:16px 0 12px;}
  .brand{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}
  .kicker{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--brass);font-weight:500;}
  .title{font-family:"Spectral",Georgia,serif;font-weight:700;font-size:clamp(26px,4.4vw,40px);line-height:1;letter-spacing:-.01em;margin:0;color:var(--ink);text-wrap:balance;}
  .title .em{color:var(--accent);}
  .mast-meta{text-align:right;display:flex;flex-direction:column;gap:3px;align-items:flex-end;}
  .mast-meta .date{font-family:"IBM Plex Mono",monospace;font-size:12.5px;color:var(--ink-2);font-weight:500;}
  .mast-meta .sub{font-size:11px;color:var(--muted);letter-spacing:.02em;}
  .themebtn{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;background:transparent;color:var(--ink-2);border:1px solid var(--hair-strong);border-radius:999px;padding:4px 11px;cursor:pointer;margin-top:2px;}
  .themebtn:hover{border-color:var(--accent);color:var(--accent);}

  .ribbon{border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);background:var(--surface);overflow:hidden;position:relative;}
  .ribbon::before,.ribbon::after{content:"";position:absolute;top:0;bottom:0;width:40px;z-index:2;pointer-events:none;}
  .ribbon::before{left:0;background:linear-gradient(90deg,var(--surface),transparent);}
  .ribbon::after{right:0;background:linear-gradient(270deg,var(--surface),transparent);}
  .ticker-track{display:flex;width:max-content;animation:scroll-x 60s linear infinite;}
  .ticker-track:hover{animation-play-state:paused;}
  .tick{display:inline-flex;align-items:baseline;gap:8px;padding:9px 22px;border-right:1px solid var(--hair);font-family:"IBM Plex Mono",monospace;font-size:12.5px;white-space:nowrap;}
  .tick .nm{color:var(--muted);letter-spacing:.04em;font-size:11px;text-transform:uppercase;}
  .tick .vl{color:var(--ink);font-weight:500;}
  .tick .ch{font-weight:500;}
  .up{color:var(--up);} .down{color:var(--down);}
  @keyframes scroll-x{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion:reduce){.ticker-track{animation:none;flex-wrap:nowrap;overflow-x:auto;width:100%;}}

  .tabbar{display:flex;gap:2px;padding-top:4px;overflow-x:auto;scrollbar-width:none;}
  .tabbar::-webkit-scrollbar{display:none;}
  .tab{appearance:none;background:transparent;border:0;cursor:pointer;font-family:"IBM Plex Sans",sans-serif;font-size:13.5px;font-weight:600;color:var(--muted);padding:12px 4px;margin-right:26px;white-space:nowrap;border-bottom:2.5px solid transparent;letter-spacing:.01em;display:inline-flex;align-items:center;gap:8px;}
  .tab .idx{font-family:"IBM Plex Mono",monospace;font-size:10.5px;color:var(--muted);}
  .tab:hover{color:var(--ink-2);}
  .tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent);}
  .tab[aria-selected="true"] .idx{color:var(--brass);}

  main{padding:34px 0 20px;}
  .panel{display:none;animation:rise .5s cubic-bezier(.2,.7,.2,1) both;}
  .panel.active{display:block;}
  @keyframes rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
  @media (prefers-reduced-motion:reduce){.panel{animation:none;}}

  .lede{max-width:68ch;margin:0 0 26px;}
  .lede .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);margin:0 0 8px;font-weight:500;}
  .lede h2{font-family:"Spectral",Georgia,serif;font-weight:600;font-size:clamp(21px,3vw,27px);margin:0 0 8px;letter-spacing:-.01em;text-wrap:balance;color:var(--ink);}
  .lede p{margin:0;color:var(--ink-2);font-size:15px;}

  .section-rule{display:flex;align-items:center;gap:12px;margin:34px 0 18px;}
  .section-rule h3{font-family:"IBM Plex Mono",monospace;font-size:11.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2);margin:0;white-space:nowrap;}
  .section-rule::after{content:"";flex:1;height:1px;background:var(--hair);}

  .tiles{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));}
  .tile{background:var(--surface);border:1px solid var(--hair);border-radius:12px;padding:16px 17px 15px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  .tile::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent);opacity:.9;}
  .tile.pos::before{background:var(--up);}
  .tile.neg::before{background:var(--down);}
  .tile .lbl{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 9px;font-weight:500;}
  .tile .val{font-family:"IBM Plex Mono",monospace;font-size:clamp(25px,3.4vw,31px);font-weight:500;line-height:1;color:var(--ink);letter-spacing:-.01em;}
  .tile .val .unit{font-size:15px;color:var(--ink-2);}
  .tile .delta{font-family:"IBM Plex Mono",monospace;font-size:12.5px;margin-top:9px;font-weight:500;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .tile .note{font-size:11.5px;color:var(--muted);margin-top:7px;line-height:1.35;}

  .grid-2{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));}
  .card{background:var(--surface);border:1px solid var(--hair);border-radius:14px;padding:20px 20px 16px;box-shadow:var(--shadow);}
  .card h4{font-family:"Spectral",Georgia,serif;font-weight:600;font-size:17px;margin:0 0 3px;color:var(--ink);letter-spacing:-.005em;}
  .card .csub{font-size:12px;color:var(--muted);margin:0 0 16px;}
  .chart{width:100%;}
  .chart text{font-family:"IBM Plex Mono",monospace;}
  .axis-label{fill:var(--muted);font-size:10.5px;letter-spacing:.03em;}
  .val-label{fill:var(--ink);font-size:11.5px;font-weight:500;font-variant-numeric:tabular-nums;}
  .grid-line{stroke:var(--grid);stroke-width:1;}
  .baseline{stroke:var(--hair-strong);stroke-width:1;}
  .legend{display:flex;flex-wrap:wrap;gap:16px;margin-top:14px;padding-top:12px;border-top:1px solid var(--hair);}
  .legend .li{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-2);font-family:"IBM Plex Mono",monospace;}
  .legend .sw{width:11px;height:11px;border-radius:3px;flex:none;}

  .prose{max-width:66ch;}
  .prose p{color:var(--ink-2);font-size:14.5px;margin:0 0 14px;}
  .prose strong{color:var(--ink);font-weight:600;}
  .callout{border-left:3px solid var(--brass);background:var(--surface-2);padding:13px 16px;border-radius:0 10px 10px 0;margin:4px 0 20px;max-width:66ch;}
  .callout p{margin:0;font-size:14px;color:var(--ink-2);}
  .callout .q{font-family:"Spectral",serif;font-style:italic;font-size:15px;color:var(--ink);}

  .timeline{position:relative;margin:6px 0 8px;}
  .timeline::before{content:"";position:absolute;left:92px;top:6px;bottom:6px;width:1px;background:var(--hair);}
  .ev{display:grid;grid-template-columns:92px 1fr;gap:0;padding:12px 0;position:relative;}
  .ev .when{font-family:"IBM Plex Mono",monospace;font-size:11.5px;color:var(--muted);padding-top:2px;letter-spacing:.02em;}
  .ev .body{padding-left:26px;position:relative;}
  .ev .body::before{content:"";position:absolute;left:-5px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--surface);border:2px solid var(--accent);}
  .ev.big .body::before{background:var(--down);border-color:var(--down);}
  .ev.good .body::before{background:var(--up);border-color:var(--up);}
  .ev h5{font-family:"IBM Plex Sans",sans-serif;font-size:14.5px;font-weight:600;margin:0 0 3px;color:var(--ink);line-height:1.35;}
  .ev p{margin:0;font-size:13px;color:var(--ink-2);}
  .ev .tag{font-family:"IBM Plex Mono",monospace;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-left:8px;}

  /* CRE headline list */
  .newslist{display:grid;gap:2px;}
  .news{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:baseline;padding:13px 4px;border-bottom:1px solid var(--hair);}
  .news:last-child{border-bottom:0;}
  .news a{font-family:"IBM Plex Sans",sans-serif;font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.4;}
  .news a:hover{color:var(--accent);}
  .news .src{font-family:"IBM Plex Mono",monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);white-space:nowrap;padding-top:2px;}
  .news .blurb{grid-column:1/-1;margin:3px 0 0;font-size:13px;color:var(--ink-2);}

  /* Watchlist table */
  .wl-wrap{overflow-x:auto;}
  table.wl{width:100%;border-collapse:collapse;font-size:14px;}
  table.wl th{text-align:left;font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;padding:0 14px 10px 0;border-bottom:1px solid var(--hair);}
  table.wl td{padding:12px 14px 12px 0;border-bottom:1px solid var(--hair);vertical-align:baseline;}
  table.wl tr:last-child td{border-bottom:0;}
  table.wl th.num,table.wl td.num{text-align:right;padding-right:0;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .wl-code{font-family:"IBM Plex Mono",monospace;font-weight:600;color:var(--ink);white-space:nowrap;}
  .wl-desc{color:var(--ink-2);font-size:13px;}
  .wl-foot{font-size:11px;color:var(--muted);margin:12px 0 0;}

  footer{border-top:1px solid var(--hair);margin-top:40px;padding:26px 0 44px;}
  footer .disc{font-size:12px;color:var(--muted);max-width:70ch;margin:0 0 16px;line-height:1.5;}
  footer .srcs{font-family:"IBM Plex Mono",monospace;font-size:11.5px;color:var(--ink-2);display:flex;flex-wrap:wrap;gap:6px 14px;}
  footer .srcs a{color:var(--ink-2);}
  footer .stamp{font-family:"IBM Plex Mono",monospace;font-size:10.5px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-top:18px;}

  .pill{display:inline-flex;align-items:center;gap:5px;font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:500;padding:3px 9px;border-radius:999px;border:1px solid var(--hair-strong);color:var(--ink-2);}
  .pill.hawk{color:var(--down);border-color:color-mix(in srgb,var(--down) 40%,var(--hair));background:color-mix(in srgb,var(--down) 8%,transparent);}
  .pill.watch{color:var(--brass);border-color:color-mix(in srgb,var(--brass) 40%,var(--hair));background:color-mix(in srgb,var(--brass) 9%,transparent);}

  @media (max-width:560px){
    .mast-top{flex-direction:column;align-items:flex-start;gap:10px;}
    .mast-meta{text-align:left;align-items:flex-start;}
    .timeline::before{left:78px;} .ev{grid-template-columns:78px 1fr;}
    .news{grid-template-columns:1fr;} .news .src{padding-top:0;}
  }
</style>
<script>
  /* Dark is the default: honor an explicit stored choice, otherwise dark. Runs before paint to avoid a flash. */
  (function(){ try{ var t=localStorage.getItem('sb-theme'); document.documentElement.setAttribute('data-theme', t==='light' ? 'light':'dark'); }catch(e){ document.documentElement.setAttribute('data-theme','dark'); } })();
</script>
</head>
<body>

{%- macro tile(t) -%}
<div class="tile {{ t.tone|default('') }}">
  <p class="lbl">{{ t.lbl }}</p>
  <div class="val mono">{{ t.val }}{% if t.unit %}<span class="unit">{{ t.unit }}</span>{% endif %}</div>
  {%- if t.delta %}
  <div class="delta {% if t.delta.dir>0 %}up{% elif t.delta.dir<0 %}down{% endif %}">
    {% if t.delta.dir>0 %}▴ {% elif t.delta.dir<0 %}▾ {% endif %}{{ t.delta.txt }}{% if t.delta.note %} <span style="color:var(--muted)">{{ t.delta.note }}</span>{% endif %}
  </div>
  {%- endif %}
  {%- if t.pill %}<div class="delta"><span class="pill {{ t.pill.cls|default('') }}">{{ t.pill.txt }}</span></div>{% endif %}
  {%- if t.note %}<p class="note">{{ t.note|safe }}</p>{% endif %}
</div>
{%- endmacro -%}

{%- macro newsitem(n) -%}
<div class="news">
  <a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.title }}</a>
  <span class="src">{{ n.source }}{% if n.when %} · {{ n.when }}{% endif %}</span>
  {%- if n.blurb %}<p class="blurb">{{ n.blurb }}</p>{% endif %}
</div>
{%- endmacro -%}

<div class="masthead">
  <div class="wrap">
    <div class="mast-top">
      <div class="brand">
        <div>
          <p class="kicker">Daily Markets &amp; Rates Brief</p>
          <h1 class="title">The Standpoint <span class="em">Brief</span></h1>
        </div>
      </div>
      <div class="mast-meta">
        <span class="date">{{ meta.date_line }}</span>
        <span class="sub">{{ meta.as_of }}</span>
        <button class="themebtn" id="themebtn" type="button" aria-label="Toggle color theme">Theme</button>
      </div>
    </div>
  </div>
  <div class="ribbon" aria-label="Key market metrics">
    <div class="ticker-track" id="ticker"></div>
  </div>
  <div class="wrap">
    <div class="tabbar" role="tablist" aria-label="Sections">
      <button class="tab" role="tab" id="tab-markets" aria-controls="p-markets" aria-selected="true"><span class="idx">01</span> Markets &amp; Indices</button>
      <button class="tab" role="tab" id="tab-economy" aria-controls="p-economy" aria-selected="false"><span class="idx">02</span> Global Economy</button>
      <button class="tab" role="tab" id="tab-news" aria-controls="p-news" aria-selected="false"><span class="idx">03</span> Daily Headlines</button>
      <button class="tab" role="tab" id="tab-cre" aria-controls="p-cre" aria-selected="false"><span class="idx">04</span> Commercial Real Estate</button>
      <button class="tab" role="tab" id="tab-credit" aria-controls="p-credit" aria-selected="false"><span class="idx">05</span> Credit &amp; Spreads</button>
    </div>
  </div>
</div>

<main>
  <div class="wrap">

    <!-- MARKETS -->
    <section class="panel active" id="p-markets" role="tabpanel" aria-labelledby="tab-markets">
      <div class="lede">
        <p class="eyebrow">Equities · Session Setup</p>
        <h2>{{ markets.headline }}</h2>
        <p>{{ markets.standfirst|safe }}</p>
      </div>
      <div class="tiles">
        {%- for t in markets_tiles %}{{ tile(t) }}{% endfor %}
      </div>
      <div class="section-rule"><h3>What's moving the tape</h3></div>
      <div class="grid-2">
        <div class="card prose" style="max-width:none">
          <h4>{{ markets.card1_title }}</h4>
          <p class="csub">{{ markets.card1_sub }}</p>
          {%- for para in markets.card1_body %}<p>{{ para|safe }}</p>{% endfor %}
        </div>
        <div class="card">
          <h4>{{ markets.card2_title }}</h4>
          <p class="csub">{{ markets.card2_sub }}</p>
          <div style="display:flex;flex-direction:column;gap:14px;margin-top:4px">
            {%- for c in markets.catalysts %}
            <div style="display:flex;gap:13px;align-items:flex-start">
              <span class="pill watch">{{ c.when }}</span>
              <div><strong style="color:var(--ink);font-size:14.5px">{{ c.title }}</strong><p style="margin:2px 0 0;font-size:13px;color:var(--ink-2)">{{ c.body|safe }}</p></div>
            </div>
            {%- endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- ECONOMY -->
    <section class="panel" id="p-economy" role="tabpanel" aria-labelledby="tab-economy" hidden>
      <div class="lede">
        <p class="eyebrow">Macro · Policy</p>
        <h2>{{ economy.headline }}</h2>
        <p>{{ economy.standfirst|safe }}</p>
      </div>
      <div class="tiles">
        {%- for t in economy_tiles %}{{ tile(t) }}{% endfor %}
      </div>
      <div class="section-rule"><h3>Reading the policy tea leaves</h3></div>
      {%- if economy.callout %}<div class="callout"><p class="q">{{ economy.callout }}</p></div>{% endif %}
      <div class="prose">
        {%- for para in economy.body %}<p>{{ para|safe }}</p>{% endfor %}
      </div>
    </section>

    <!-- NEWS -->
    <section class="panel" id="p-news" role="tabpanel" aria-labelledby="tab-news" hidden>
      <div class="lede">
        <p class="eyebrow">The Tape · This Week</p>
        <h2>{{ news.headline }}</h2>
        <p>{{ news.standfirst|safe }}</p>
      </div>
      <div class="timeline">
        {%- for e in headlines %}
        <div class="ev {{ e.kind|default('') }}">
          <div class="when">{{ e.when }}</div>
          <div class="body">
            <h5>{% if e.link %}<a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}{% if e.tag %} <span class="tag">{{ e.tag }}</span>{% endif %}</h5>
            {%- if e.blurb %}<p>{{ e.blurb }}</p>{% endif %}
          </div>
        </div>
        {%- endfor %}
      </div>
    </section>

    <!-- CRE -->
    <section class="panel" id="p-cre" role="tabpanel" aria-labelledby="tab-cre" hidden>
      <div class="lede">
        <p class="eyebrow">Commercial Real Estate · Rates &amp; Lending</p>
        <h2>{{ cre.headline }}</h2>
        <p>{{ cre.standfirst|safe }}</p>
      </div>
      <div class="tiles">
        {%- for t in cre_tiles %}{{ tile(t) }}{% endfor %}
      </div>

      <div class="section-rule"><h3>The charts that matter</h3></div>
      <div class="grid-2">
        <div class="card">
          <h4>U.S. Treasury yield curve</h4>
          <p class="csub">Par yields by maturity · {{ cre.curve_date }}</p>
          <svg class="chart" id="chart-curve" viewBox="0 0 520 300" role="img" aria-label="Treasury yield curve by maturity"></svg>
          <div class="legend"><div class="li"><span class="sw" style="background:var(--s1)"></span> Par yield (%)</div></div>
        </div>
        <div class="card">
          <h4>The refinancing gap</h4>
          <p class="csub">Rate on expiring debt vs. newly issued CRE loans</p>
          <svg class="chart" id="chart-gap" viewBox="0 0 520 300" role="img" aria-label="Expiring CRE debt rate versus new loan rate"></svg>
          <div class="legend">
            <div class="li"><span class="sw" style="background:var(--s1-soft)"></span> Expiring debt</div>
            <div class="li"><span class="sw" style="background:var(--s1)"></span> New issuance</div>
          </div>
        </div>
      </div>
      <div class="grid-2" style="margin-top:16px">
        <div class="card">
          <h4>Lending is forecast to rebound</h4>
          <p class="csub">Total commercial mortgage originations · MBA forecast</p>
          <svg class="chart" id="chart-orig" viewBox="0 0 520 260" role="img" aria-label="Commercial mortgage originations by year"></svg>
        </div>
        <div class="card prose" style="max-width:none">
          <h4>{{ cre.card_title }}</h4>
          <p class="csub">{{ cre.card_sub }}</p>
          {%- for para in cre.card_body %}<p>{{ para|safe }}</p>{% endfor %}
        </div>
      </div>

      {%- if cre_fund_tiles %}
      <div class="section-rule"><h3>CRE credit fundamentals</h3></div>
      <div class="tiles">
        {%- for t in cre_fund_tiles %}{{ tile(t) }}{% endfor %}
      </div>
      {%- endif %}

      {%- if watchlist %}
      <div class="section-rule"><h3>Watchlist · public-market signals</h3></div>
      <div class="card">
        <div class="wl-wrap">
          <table class="wl">
            <thead><tr><th>Ticker</th><th>Tracks</th><th class="num">Last</th><th class="num">Day</th></tr></thead>
            <tbody>
              {%- for w in watchlist %}
              <tr>
                <td class="wl-code">{{ w.code }}</td>
                <td class="wl-desc">{{ w.desc }}</td>
                <td class="num mono">{{ w.price }}</td>
                <td class="num mono {% if w.dir>0 %}up{% elif w.dir<0 %}down{% endif %}">{{ w.chg }}</td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        {%- if watchlist_note %}<p class="wl-foot">{{ watchlist_note }}</p>{% endif %}
      </div>
      {%- endif %}

      {%- if cre_headlines %}
      <div class="section-rule"><h3>CRE headlines</h3></div>
      <div class="card">
        <div class="newslist">
          {%- for n in cre_headlines %}{{ newsitem(n) }}{% endfor %}
        </div>
      </div>
      {%- endif %}

      {%- if cre.callout %}
      <div class="callout" style="margin-top:22px"><p>{{ cre.callout|safe }}</p></div>
      {%- endif %}
    </section>

    <!-- CREDIT & SPREADS -->
    <section class="panel" id="p-credit" role="tabpanel" aria-labelledby="tab-credit" hidden>
      <div class="lede">
        <p class="eyebrow">Credit &amp; Spreads · Cost of Debt</p>
        <h2>{{ credit.headline }}</h2>
        <p>{{ credit.standfirst|safe }}</p>
      </div>
      <div class="tiles">
        {%- for t in credit_tiles %}{{ tile(t) }}{% endfor %}
      </div>
      <div class="section-rule"><h3>Spread comparison</h3></div>
      <div class="grid-2">
        <div class="card">
          <h4>Option-adjusted spreads</h4>
          <p class="csub">Investment-grade vs. high-yield, over Treasuries</p>
          <svg class="chart" id="chart-credit" viewBox="0 0 520 260" role="img" aria-label="Investment-grade versus high-yield option-adjusted spreads"></svg>
        </div>
        <div class="card prose" style="max-width:none">
          <h4>{{ credit.card_title }}</h4>
          <p class="csub">{{ credit.card_sub }}</p>
          {%- for para in credit.card_body %}<p>{{ para|safe }}</p>{% endfor %}
        </div>
      </div>
    </section>

  </div>
</main>

<footer>
  <div class="wrap">
    <p class="disc"><strong style="color:var(--ink-2)">Informational only — not investment advice.</strong> Figures are compiled automatically from public sources and are point-in-time snapshots that move intraday. Verify against a live data provider before acting.</p>
    <div class="srcs">
      <span style="color:var(--muted)">Sources:</span>
      {%- for s in sources %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>{% endfor %}
    </div>
    <p class="stamp">{{ meta.compiled }}</p>
  </div>
</footer>

<script id="brief-data" type="application/json">{{ chart_data_json|safe }}</script>
<script>
(function(){
  "use strict";
  var BD = {};
  try { BD = JSON.parse(document.getElementById('brief-data').textContent); } catch(e){ BD = {}; }

  /* Ticker */
  function tickHTML(t){
    var cls = t.dir>0 ? "up" : (t.dir<0 ? "down" : "");
    var arrow = t.dir>0 ? "▴ " : (t.dir<0 ? "▾ " : "");
    var ch = t.ch ? '<span class="ch '+cls+'">'+arrow+t.ch+'</span>' : '';
    return '<span class="tick"><span class="nm">'+t.nm+'</span><span class="vl">'+t.vl+'</span>'+ch+'</span>';
  }
  var ticks = BD.ticker || [];
  var trackHTML = ticks.map(tickHTML).join("");
  document.getElementById("ticker").innerHTML = trackHTML + trackHTML;

  /* Tabs */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
  var panels = {'tab-markets':'p-markets','tab-economy':'p-economy','tab-news':'p-news','tab-cre':'p-cre','tab-credit':'p-credit'};
  var drawn = {};
  function activate(id){
    tabs.forEach(function(t){
      var on = t.id===id;
      t.setAttribute('aria-selected', on ? 'true':'false');
      var p = document.getElementById(panels[t.id]);
      p.classList.toggle('active', on);
      if(on){ p.removeAttribute('hidden'); } else { p.setAttribute('hidden',''); }
    });
    if(id==='tab-cre' && !drawn.cre){ drawCRE(); drawn.cre = true; }
    if(id==='tab-credit' && !drawn.credit){ drawCredit(); drawn.credit = true; }
    try{ localStorage.setItem('sb-tab', id); }catch(e){}
  }
  tabs.forEach(function(t){
    t.addEventListener('click', function(){ activate(t.id); });
    t.addEventListener('keydown', function(e){
      var i = tabs.indexOf(t);
      if(e.key==='ArrowRight'){ e.preventDefault(); tabs[(i+1)%tabs.length].click(); tabs[(i+1)%tabs.length].focus(); }
      if(e.key==='ArrowLeft'){ e.preventDefault(); tabs[(i-1+tabs.length)%tabs.length].click(); tabs[(i-1+tabs.length)%tabs.length].focus(); }
    });
  });
  var saved=null; try{ saved=localStorage.getItem('sb-tab'); }catch(e){}
  if(saved && panels[saved]){ activate(saved); }

  /* Theme toggle */
  var tb=document.getElementById('themebtn');
  tb.addEventListener('click', function(){
    var root=document.documentElement, cur=root.getAttribute('data-theme');
    var isDark = cur ? cur==='dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    var next = isDark ? 'light':'dark';
    root.setAttribute('data-theme', next);
    try{ localStorage.setItem('sb-theme', next); }catch(e){}
    redraw();
  });
  try{ var st=localStorage.getItem('sb-theme'); if(st){ document.documentElement.setAttribute('data-theme', st); } }catch(e){}

  /* Chart helpers */
  var SVGNS="http://www.w3.org/2000/svg";
  function el(tag,attrs){ var e=document.createElementNS(SVGNS,tag); for(var k in attrs){ e.setAttribute(k,attrs[k]); } return e; }
  function cssv(n){ return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
  function clear(node){ while(node.firstChild) node.removeChild(node.firstChild); }

  function drawCurve(){
    var curve = BD.curve || [];
    var svg=document.getElementById('chart-curve'); if(!svg) return; clear(svg);
    if(!curve.length) return;
    var W=520,H=300,m={t:18,r:18,b:40,l:44}, iw=W-m.l-m.r, ih=H-m.t-m.b;
    var s1=cssv('--s1');
    var ys=curve.map(function(p){return p.y;});
    var yMin=Math.floor(Math.min.apply(null,ys)*2)/2-0.2;
    var yMax=Math.ceil(Math.max.apply(null,ys)*2)/2+0.2;
    var xMax=Math.max.apply(null,curve.map(function(p){return p.x;}));
    function X(x){ return m.l + Math.sqrt(x/xMax)*iw; }
    function Y(v){ return m.t + (1-(v-yMin)/(yMax-yMin))*ih; }
    var steps=4;
    for(var i=0;i<=steps;i++){ var v=yMin+(yMax-yMin)*i/steps;
      svg.appendChild(el('line',{x1:m.l,y1:Y(v),x2:m.l+iw,y2:Y(v),class:'grid-line'}));
      var tx=el('text',{x:m.l-8,y:Y(v)+3,'text-anchor':'end',class:'axis-label'}); tx.textContent=v.toFixed(1); svg.appendChild(tx);
    }
    var dTop=curve.map(function(p,i){return (i?'L':'M')+X(p.x)+' '+Y(p.y);}).join(' ');
    var area=dTop+' L'+X(curve[curve.length-1].x)+' '+(m.t+ih)+' L'+X(curve[0].x)+' '+(m.t+ih)+' Z';
    var grad=el('linearGradient',{id:'gcurve',x1:0,y1:0,x2:0,y2:1});
    grad.appendChild(el('stop',{offset:'0%','stop-color':s1,'stop-opacity':0.20}));
    grad.appendChild(el('stop',{offset:'100%','stop-color':s1,'stop-opacity':0.02}));
    var defs=el('defs',{}); defs.appendChild(grad); svg.appendChild(defs);
    svg.appendChild(el('path',{d:area,fill:'url(#gcurve)'}));
    svg.appendChild(el('line',{x1:m.l,y1:m.t+ih,x2:m.l+iw,y2:m.t+ih,class:'baseline'}));
    var line=el('path',{d:dTop,fill:'none',stroke:s1,'stroke-width':2.4,'stroke-linejoin':'round','stroke-linecap':'round'});
    svg.appendChild(line);
    var len=line.getTotalLength?line.getTotalLength():0;
    if(len){ line.setAttribute('stroke-dasharray',len); line.setAttribute('stroke-dashoffset',len);
      line.appendChild(el('animate',{attributeName:'stroke-dashoffset',from:len,to:0,dur:'1.1s',fill:'freeze',calcMode:'spline',keySplines:'.2 .7 .2 1',keyTimes:'0;1'})); }
    curve.forEach(function(p){ svg.appendChild(el('circle',{cx:X(p.x),cy:Y(p.y),r:3.4,fill:cssv('--surface'),stroke:s1,'stroke-width':2})); });
    curve.forEach(function(p){ if(p.mark){ var lbl=el('text',{x:X(p.x),y:Y(p.y)-11,'text-anchor':'middle',class:'val-label'}); lbl.textContent=p.y.toFixed(2); svg.appendChild(lbl); } });
    curve.forEach(function(p){ if(p.axis){ var tx=el('text',{x:X(p.x),y:m.t+ih+22,'text-anchor':'middle',class:'axis-label'}); tx.textContent=p.t; svg.appendChild(tx); } });
  }

  function drawBars(svgId,data,opts){
    var svg=document.getElementById(svgId); if(!svg) return; clear(svg); opts=opts||{};
    var vb=svg.getAttribute('viewBox').split(' '), W=+vb[2],H=+vb[3], m={t:opts.mt||24,r:20,b:44,l:opts.ml||46};
    var iw=W-m.l-m.r, ih=H-m.t-m.b;
    var maxV=opts.max||Math.max.apply(null,data.map(function(d){return d.v;}))*1.15;
    function Y(v){ return m.t+(1-v/maxV)*ih; }
    var ticks=opts.ticks||4;
    for(var i=0;i<=ticks;i++){ var v=maxV*i/ticks;
      svg.appendChild(el('line',{x1:m.l,y1:Y(v),x2:m.l+iw,y2:Y(v),class:'grid-line'}));
      var tx=el('text',{x:m.l-8,y:Y(v)+3,'text-anchor':'end',class:'axis-label'}); tx.textContent=(opts.fmtY?opts.fmtY(v):v.toFixed(0)); svg.appendChild(tx); }
    svg.appendChild(el('line',{x1:m.l,y1:m.t+ih,x2:m.l+iw,y2:m.t+ih,class:'baseline'}));
    var n=data.length, gap=opts.gap||0.42, bw=iw/n*(1-gap);
    data.forEach(function(d,i){
      var cx=m.l+iw*(i+0.5)/n, x=cx-bw/2, y=Y(d.v), h=(m.t+ih)-y, col=d.color||cssv('--s1');
      var r=el('rect',{x:x,y:m.t+ih,width:bw,height:0,rx:4,fill:col});
      if(d.hatch){ r.setAttribute('fill','url(#hatch)'); r.setAttribute('stroke',col); r.setAttribute('stroke-width','1.4'); }
      svg.appendChild(r);
      r.appendChild(el('animate',{attributeName:'height',from:0,to:h,dur:'0.8s',fill:'freeze',calcMode:'spline',keySplines:'.2 .7 .2 1',keyTimes:'0;1',begin:(i*0.09)+'s'}));
      r.appendChild(el('animate',{attributeName:'y',from:m.t+ih,to:y,dur:'0.8s',fill:'freeze',calcMode:'spline',keySplines:'.2 .7 .2 1',keyTimes:'0;1',begin:(i*0.09)+'s'}));
      var vl=el('text',{x:cx,y:y-9,'text-anchor':'middle',class:'val-label'}); vl.textContent=d.label; vl.setAttribute('opacity',0);
      vl.appendChild(el('animate',{attributeName:'opacity',from:0,to:1,dur:'0.4s',fill:'freeze',begin:(i*0.09+0.5)+'s'})); svg.appendChild(vl);
      var cl=el('text',{x:cx,y:m.t+ih+22,'text-anchor':'middle',class:'axis-label'}); cl.textContent=d.name; svg.appendChild(cl);
      if(d.sub){ var cl2=el('text',{x:cx,y:m.t+ih+35,'text-anchor':'middle',class:'axis-label'}); cl2.setAttribute('opacity',0.75); cl2.textContent=d.sub; svg.appendChild(cl2); }
    });
    if(!document.getElementById('hatch')){
      var defs=el('defs',{}); var pat=el('pattern',{id:'hatch',width:6,height:6,patternTransform:'rotate(45)',patternUnits:'userSpaceOnUse'});
      pat.appendChild(el('rect',{width:6,height:6,fill:cssv('--s1'),'fill-opacity':0.14}));
      pat.appendChild(el('line',{x1:0,y1:0,x2:0,y2:6,stroke:cssv('--s1'),'stroke-width':2.4}));
      defs.appendChild(pat); svg.appendChild(defs);
    }
  }
  function drawGap(){
    var g=BD.gap||{expiring:0,new:0};
    drawBars('chart-gap',[
      {name:'Expiring debt',v:g.expiring,label:g.expiring.toFixed(2)+'%',color:cssv('--s1-soft')},
      {name:'New CRE loans',v:g.new,label:g.new.toFixed(2)+'%',color:cssv('--s1')}
    ],{max:Math.ceil(Math.max(g.expiring,g.new))+1,ticks:Math.ceil(Math.max(g.expiring,g.new))+1,gap:0.5,fmtY:function(v){return v.toFixed(0)+'%';}});
  }
  function drawOrig(){
    var o=BD.orig||{y2025:0,y2026:0};
    drawBars('chart-orig',[
      {name:'2025',sub:'estimate',v:o.y2025,label:'$'+o.y2025.toFixed(1)+'B',color:cssv('--s1-soft')},
      {name:'2026',sub:'forecast',v:o.y2026,label:'$'+o.y2026.toFixed(1)+'B',color:cssv('--s1'),hatch:true}
    ],{max:Math.ceil(Math.max(o.y2025,o.y2026)/100)*100+100,ticks:3,gap:0.5,mt:28,ml:52,fmtY:function(v){return '$'+Math.round(v)+'B';}});
  }
  function drawCredit(){
    var c=BD.credit||{ig:0,hy:0};
    var mx=Math.max(1,Math.ceil(Math.max(c.ig,c.hy)))+1;
    drawBars('chart-credit',[
      {name:'Investment-grade',sub:'BBB',v:c.ig,label:c.ig.toFixed(2)+'%',color:cssv('--s1-soft')},
      {name:'High-yield',sub:'BB & below',v:c.hy,label:c.hy.toFixed(2)+'%',color:cssv('--s1')}
    ],{max:mx,ticks:mx,gap:0.5,mt:28,fmtY:function(v){return v.toFixed(0)+'%';}});
  }
  function drawCRE(){ drawCurve(); drawGap(); drawOrig(); }
  function redraw(){ if(drawn.cre){ drawCRE(); } if(drawn.credit){ drawCredit(); } }
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw);
  if(document.getElementById('p-cre').classList.contains('active')){ drawCRE(); drawn.cre=true; }
  if(document.getElementById('p-credit').classList.contains('active')){ drawCredit(); drawn.credit=true; }
})();
</script>
</body>
</html>
